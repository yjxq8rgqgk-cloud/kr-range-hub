      "--halo-space-3",
      "--halo-space-4",
      "--halo-space-5",
      "--halo-space-6",
      "--halo-space-7",
      "--halo-space-8",
      "--halo-success",
      "--halo-surface-1",
      "--halo-surface-2",
      "--halo-surface-3",
      "--halo-surface-hover"
    ],
    "tokenKinds": {
      "--halo-bg": "color",
      "--halo-surface-1": "color",
      "--halo-surface-2": "color",
      "--halo-surface-3": "color",
      "--halo-surface-hover": "color",
      "--halo-fg": "color",
      "--halo-fg-muted": "color",
      "--halo-fg-dim": "color",
      "--halo-hairline": "color",
      "--halo-hairline-strong": "color",
      "--halo-accent": "color",
      "--halo-accent-soft": "color",
      "--halo-accent-glow": "color",
      "--halo-success": "color",
      "--halo-font-display": "font",
      "--halo-font-body": "font",
      "--halo-font-mono": "font",
      "--halo-radius-sm": "radius",
      "--halo-radius-md": "radius",
      "--halo-radius-lg": "radius",
      "--halo-radius-xl": "radius",
      "--halo-radius-pill": "radius",
      "--halo-space-1": "spacing",
